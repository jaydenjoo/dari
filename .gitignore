# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/tests/e2e/.state

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# design references — keep MD guides, exclude heavy binaries (zip, exported page folders)
docs/design-references/*
!docs/design-references/*.md

# Playwright MCP 자동 검증 아티팩트 (스냅샷·콘솔 로그·스크린샷)
.playwright-mcp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.json.backup.*

# widget bundle (scripts/build-widget.mjs 산출물)
/public/widget.js
/public/widget.js.map
package-lock.json
.gstack/
/delivery/
